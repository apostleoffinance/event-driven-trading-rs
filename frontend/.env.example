# Frontend behavior
NEXT_PUBLIC_APP_NAME=EdgeNest
NEXT_PUBLIC_ENVIRONMENT=PAPER
# api | mock. API is the default; set mock only when intentionally using sample data locally.
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_EVENT_MODE=mock

# Use a single HTTPS API gateway URL if routes are proxied by one gateway.
NEXT_PUBLIC_API_URL=

# Optional service-specific HTTPS origins. When provided, these override NEXT_PUBLIC_API_URL.
# Identity API: /api/v1/auth/*
NEXT_PUBLIC_IDENTITY_API_URL=
# Journal API: /api/v1/journal/*
NEXT_PUBLIC_JOURNAL_API_URL=
# Market Data API: /api/v1/market-data/*
NEXT_PUBLIC_MARKET_DATA_API_URL=

# Event streaming is not connected to a real Rust event service yet.
NEXT_PUBLIC_EVENT_STREAM_URL=
