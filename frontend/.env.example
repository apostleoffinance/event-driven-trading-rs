# Frontend behavior
NEXT_PUBLIC_APP_NAME=EdgeNest
NEXT_PUBLIC_ENVIRONMENT=PAPER

# Public gateway origin used only by the browser health indicator.
# All application API traffic is sent to the same-origin /api/bff routes.
NEXT_PUBLIC_API_URL=

# Server-only API origins consumed by the Cloudflare Worker BFF.
# Set these as Worker Variables in production; never prefix them with NEXT_PUBLIC_.
API_GATEWAY_ORIGIN=
IDENTITY_API_ORIGIN=
JOURNAL_API_ORIGIN=
MARKET_DATA_API_ORIGIN=
