# Frontend behavior
NEXT_PUBLIC_APP_NAME=EdgeNest
NEXT_PUBLIC_ENVIRONMENT=PAPER

# Server-only API origins consumed by the Cloudflare Worker BFF.
# Set these as Worker Variables in production; never prefix them with NEXT_PUBLIC_.
API_GATEWAY_ORIGIN=
IDENTITY_API_ORIGIN=
JOURNAL_API_ORIGIN=
MARKET_DATA_API_ORIGIN=
