{
  "edgenest_api_url": "https://edgenest-api.onrender.com",
  "state_file": "./migration-state.json",
  "report_file": "./migration-report.json",
  "owner_map": {
    "REPLACE_WITH_snapshot_source_user_id": {
      "jwt": "REPLACE_WITH_REAL_EDGENEST_USER_JWT_IN_PRIVATE_CONFIG"
    }
  },
  "source_storage": {
    "endpoint_url": "https://<traderos-account-id>.r2.cloudflarestorage.com",
    "region": "auto",
    "bucket": "traderos-source-bucket",
    "access_key_id": "TRADEROS_SOURCE_ACCESS_KEY",
    "secret_access_key": "TRADEROS_SOURCE_SECRET_KEY"
  },
  "object_storage": {
    "provider": "r2",
    "endpoint_url": "https://<edgenest-account-id>.r2.cloudflarestorage.com",
    "region": "auto",
    "bucket": "edgenest-journal-attachments",
    "prefix": "traderos-migration",
    "archive_prefix": "traderos-migration-archives",
    "access_key_id": "EDGENEST_R2_ACCESS_KEY",
    "secret_access_key": "EDGENEST_R2_SECRET_KEY"
  }
}
