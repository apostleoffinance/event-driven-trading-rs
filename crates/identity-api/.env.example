# Identity API local/deployment configuration.
# Generate an RSA key pair for local testing; never commit actual private keys.
DATABASE_URL=postgres://localhost:5432/edgenest
IDENTITY_API_BIND=0.0.0.0:8081
EDGENEST_JWT_ISSUER=http://localhost:8081
EDGENEST_JWT_AUDIENCE=edgenest-api
EDGENEST_JWT_KEY_ID=edgenest-local-2026-01
EDGENEST_JWT_PRIVATE_KEY_PEM=REPLACE_WITH_RSA_PRIVATE_PEM
EDGENEST_JWT_PUBLIC_KEY_PEM=REPLACE_WITH_MATCHING_RSA_PUBLIC_PEM
# JSON array of {kid,pem} public PEMs. Include old key PEMs during rotation.
EDGENEST_JWT_PUBLIC_KEYS_JSON=
EDGENEST_ACCESS_TOKEN_TTL_SECONDS=900
EDGENEST_REFRESH_TOKEN_TTL_DAYS=30
IDENTITY_MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_OR_MORE_OF_RANDOM_SECRET
RESEND_API_KEY=
IDENTITY_EMAIL_FROM=EdgeNest <auth@your-verified-domain.example>
EDGENEST_PUBLIC_APP_URL=http://localhost:3000
IDENTITY_CORS_ORIGINS=http://localhost:3000
